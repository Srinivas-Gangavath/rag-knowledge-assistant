# =============================================================================
# RAG Knowledge Assistant — environment template
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# Never commit a .env file that contains real secrets.
# The frontend only receives variables that start with VITE_.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
# Valid values: development | test | production
LOG_LEVEL=INFO
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# PostgreSQL
# Used by the Docker Compose 'postgres' service and by the backend.
# Keep DATABASE_URL in sync with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Inside Docker Compose the host must be the service name: postgres.
# -----------------------------------------------------------------------------
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me            # REQUIRED — change before any shared use
POSTGRES_DB=rag_knowledge
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://rag_user:change_me@postgres:5432/rag_knowledge

# -----------------------------------------------------------------------------
# CORS — comma-separated browser origins allowed to call the API.
# Never use * in deployed environments.
# -----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend (Vite — exposed to the browser)
# VITE_API_BASE_URL is the URL the user's browser uses to reach the API,
# not the internal Docker service name.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
# Client-side upload size hint only. The backend MAX_UPLOAD_SIZE_MB is authoritative.
VITE_MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Gemini (backend only — never expose these to the frontend)
# Get a key at: https://aistudio.google.com
# -----------------------------------------------------------------------------
GEMINI_API_KEY=                        # REQUIRED for ingestion and chat
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
# Supported output dimensions: 768 | 1536 | 3072
# Must match the vector(N) column created by migration 0002.

# Per-request Gemini HTTP timeout (ms) and max attempts including the original.
# The google-genai SDK otherwise retries 5xx with long backoff, which can hang chat.
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_ATTEMPTS=2

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# REQUIRED — minimum 32 characters, cryptographically random.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The application will refuse to start if this is empty or shorter than 32 chars.
JWT_SECRET_KEY=                        # REQUIRED — set before starting
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Auth Cookie (refresh token)
# -----------------------------------------------------------------------------
AUTH_COOKIE_NAME=refresh_token
# Set AUTH_COOKIE_SECURE=true in HTTPS production environments.
AUTH_COOKIE_SECURE=false
# Valid values: lax | strict | none
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth

# -----------------------------------------------------------------------------
# Bootstrap Admin
# If BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD are set, the application
# creates a default admin user on startup (idempotent; safe to leave set).
# Leave both empty to skip bootstrap.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Default Administrator

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
CHUNKING_STRATEGY=fixed_word_window
# Valid values: fixed_word_window | recursive
# 'semantic' is intentionally rejected.

CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10
STORAGE_PATH=/storage/documents

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Cosine similarity = 1 - pgvector cosine_distance (<=>).
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

RETRIEVAL_MODE=dense
# Valid values: dense | hybrid
# 'lexical' is evaluation-only and is intentionally rejected for chat.

HYBRID_CANDIDATE_K=20
HYBRID_RRF_K=60

# -----------------------------------------------------------------------------
# Reranking (opt-in — Stage 4, hybrid path only)
# Enabling this loads BAAI/bge-reranker-v2-m3 on CPU on the first request.
# Weights are cached in the huggingface_cache Docker volume (~2 GB download).
# Estimate: ~2–4 GB extra RAM while the reranker is loaded.
# -----------------------------------------------------------------------------
RERANKING_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=20
RERANK_BATCH_SIZE=16
RERANK_MAX_CHARS=24000
# If true, chat falls back to RRF order on rerank failure. Evaluation never falls back.
RERANKING_FALLBACK=true

# -----------------------------------------------------------------------------
# Conversational chat
# -----------------------------------------------------------------------------
MAX_QUESTION_LENGTH=2000
# Number of recent messages sent to the LLM prompt. Full history stays in PostgreSQL.
CONVERSATION_HISTORY_LIMIT=10
MAX_SOURCE_EVIDENCE_CHARS=3000

# -----------------------------------------------------------------------------
# Observability — Query Tracing
# -----------------------------------------------------------------------------
TRACE_RETENTION_DAYS=30
TRACE_SLOW_QUERY_THRESHOLD_MS=2000
TRACE_SLOW_RETRIEVAL_THRESHOLD_MS=800
TRACE_SLOW_LLM_THRESHOLD_MS=1500

# -----------------------------------------------------------------------------
# Operational Alerting & Anomaly Detection
# -----------------------------------------------------------------------------
TRACE_ALERT_P95_LATENCY_MS=4000
TRACE_ALERT_ERROR_RATE_PERCENT=10.0
TRACE_ALERT_LLM_P95_MS=3000
TRACE_ALERT_RETRIEVAL_P95_MS=1500
TRACE_ALERT_TTFT_P95_MS=2000
TRACE_ALERT_PROVIDER_ERROR_PERCENT=15.0
TRACE_ALERT_NO_CONTEXT_PERCENT=20.0
ALERT_DEFAULT_WINDOW_MINUTES=15
ALERT_DEFAULT_COOLDOWN_MINUTES=60
ALERT_DEFAULT_MIN_SAMPLE_SIZE=5
ALERT_ANOMALY_DEVIATION_MULTIPLIER=2.0
